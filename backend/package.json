{
  "name": "mobile-messenger-backend",
  "version": "0.1.0",
  "description": "Backend API + realtime server for the mobile-messenger Flutter app",
  "private": true,
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "lint": "eslint src",
    "test": "cross-env NODE_ENV=test node --test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.3.0",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "multer": "^2.0.0",
    "node-pg-migrate": "^7.6.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
