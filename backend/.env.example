# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

NODE_ENV=development
PORT=3000

# PostgreSQL connection (matches docker-compose.yml service "db")
DATABASE_URL=postgres://messenger:messenger@localhost:5432/messenger

# JWT secrets — generate strong random values for real deployments,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Server-side master key for the profile bio field, which is encrypted
# at rest (see src/utils/fieldCrypto.js). Any
# long random string works; it's hashed down to a 32-byte AES-256 key.
# Never stored in the database — losing/rotating it makes existing
# encrypted bios permanently unreadable, by design.
PROFILE_ENCRYPTION_KEY=change_me_profile_encryption_key

# Outgoing email (used for verification + password reset).
# For local dev, leave unset to fall back to console-logging the email
# instead of actually sending it (see src/services/email.service.js).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mobile Messenger <no-reply@mobile-messenger.local>"

# Public URL the Flutter app / emails use to reach this backend
APP_BASE_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API from a
# browser (the deployed web client's URL(s), e.g.
# https://your-app.vercel.app) — used for both the REST CORS
# middleware and the Socket.IO server. Leave unset for local dev: an
# empty value reflects any origin, which is what docker-compose.yml and
# the test suite rely on. A production deployment MUST set this — see
# README.md's Deployment section — env.js refuses to start in
# NODE_ENV=production without it.
CORS_ORIGINS=

# Max upload size in bytes (default 25MB)
MAX_UPLOAD_BYTES=26214400

# Path to a Firebase service-account JSON key, for sending push
# notifications via the Admin SDK (see src/services/push.service.js
# and docs/PUSH_NOTIFICATIONS.md for how to get one). Leave unset and
# push notifications are simply disabled — no error, no fake credential
# needed, unlike the secrets above.
FIREBASE_SERVICE_ACCOUNT_PATH=
