<?xml version="1.0" encoding="utf-8"?>
<!--
  Applies to every build type, including release — unlike
  src/debug/res/xml/network_security_config.xml (which allows cleartext
  to *any* host, but only in debug builds, and overrides this file there
  via Android's standard debug-source-set resource merging).

  This app's backend (docker-compose.yml) has no TLS set up — it's the
  local, one-command dev/review backend described in README.md's
  Reviewer Guide, not a real deployment. Without this, even a release
  build could never reach it at all: Android blocks cleartext (plain
  HTTP) traffic by default in release builds, for good reason. Rather
  than disabling that protection globally, this allows it only for the
  exact loopback-style hosts local review actually uses:
    - 10.0.2.2   — the Android emulator's alias for the host machine
    - localhost / 127.0.0.1 — a physical device, reached via
      `adb reverse tcp:3001 tcp:3001` (see README.md)

  This grants no exception for, and has no effect on, any real domain —
  a genuine deployment behind a real HTTPS domain is completely
  unaffected by this file; Android's default (cleartext blocked) still
  applies to it.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
