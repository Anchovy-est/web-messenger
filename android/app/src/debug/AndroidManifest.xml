<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Redundant with the app's own declaration in
         src/main/AndroidManifest.xml (the manifest merger just
         deduplicates it) — kept here too because this is *also* what the
         Flutter tool itself needs for hot reload / the VM service
         debug connection, independent of anything this app does over
         the network. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug-only: allow cleartext HTTP to the local dev backend. See
         res/xml/network_security_config.xml for why. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
